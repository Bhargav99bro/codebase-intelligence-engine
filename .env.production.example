# ==============================================================================
# Codebase Intelligence Engine - Production Environment Template
# Architecture: Aiven (PostgreSQL & Valkey) + Render (FastAPI/Celery) + Vercel (React)
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Codebase Intelligence Engine"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
LOG_FORMAT="json"
LOG_LEVEL="INFO"

# Security (Generate a secure 64-character hex string: openssl rand -hex 32)
SECRET_KEY="replace-with-secure-random-secret-key-min-32-chars"

BACKEND_CORS_ORIGINS="https://frontend-mauve-omega-jwwyldr41f.vercel.app"

# Database Configuration (Aiven PostgreSQL Free Tier)
# Copy the "Service URI" from your Aiven PostgreSQL service overview.
# Format: postgresql+asyncpg://avnadmin:<PASSWORD>@<HOST>:<PORT>/defaultdb?ssl=require
DATABASE_URL="postgresql+asyncpg://avnadmin:YOUR_AIVEN_PG_PASSWORD@pg-service-name.aivencloud.com:12345/defaultdb?ssl=require"

# Redis / Valkey Configuration (Aiven Valkey Free Tier)
# Copy the "Service URI" from your Aiven Valkey service overview.
# Format: rediss://default:<PASSWORD>@<HOST>:<PORT>/0
REDIS_URL="rediss://default:YOUR_AIVEN_VALKEY_PASSWORD@valkey-service-name.aivencloud.com:12345/0"

# Storage & Repository Limits
ANALYSIS_STORAGE_PATH="/tmp/cie_repos"
MAX_REPO_SIZE_MB=500
CLONE_TIMEOUT_SECONDS=60
MAX_FILE_COUNT=10000

# Rate Limiting & Concurrency
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYSIS_PER_MINUTE=20
RATE_LIMIT_COMPARE_PER_MINUTE=60
RATE_LIMIT_EXPORT_PER_MINUTE=60
RATE_LIMIT_ALLOW_MEMORY_FALLBACK=false
MAX_CONCURRENT_ANALYSES=5

# Security Controls
ENABLE_SECURITY_HEADERS=true
